# ============================================================================
# Template de configuration — copie ce fichier en .env.local (make setup).
# .env.example et .env.test sont versionnés ; .env.local / .env.prod sont ignorés.
# APP_ENV est injecté par Docker Compose (override par environnement), pas ici.
# ============================================================================

# --- PostgreSQL (interpolation Docker Compose) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=financialrag

# --- Génération (Groq AI) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Embeddings (Ollama, en natif sur l'hôte) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=bge-m3

# --- Fournisseur LLM actif : mistral | ollama ---
LLM_PROVIDER=mistral

# --- Logs ---
LOG_LEVEL=INFO

# Pour lancer le backend en dehors d'un conteneur (uvicorn sur l'hôte), décommente :
# DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/financialrag